# Copiar a .env (en el repo, o en la carpeta padre como hace el API en prod). Nunca al repo.
# Las variables del sistema ganan sobre este archivo.

# dev | prod, sin valor por defecto: sin esto el servicio no arranca
AGENTS_ENVIRONMENT=dev

# MySQL: usuario agents_svc (scripts_db_handle/agentes_schema_y_usuario.sql del repo GUITelintec)
DB_HOST=
DB_PORT=3306
DB_USER=agents_svc
DB_PASSWORD=
DB_CATALOG=sql_telintec
DB_AGENTS=sql_telintec_mod_agents
DB_POOL_SIZE=5

# Llaves publicas ES256 del login: token_public_<kid>.pem. Por defecto, la carpeta de este .env
# y los kids `lambda` (+ `dev` en dev). Apuntar a la carpeta del .env del API para no copiarlas.
#TOKEN_PUBLIC_KEYS_DIR=C:/Users/.../PycharmProjects/GUITelintec
#TOKEN_PUBLIC_KIDS=lambda,dev
#TOKEN_LEEWAY_SECONDS=30

# OpenAI: una llave por proyecto (P-247). Solo aqui, nunca en el repo GUITelintec.
OPENAI_API_KEY_SALES=
OPENAI_API_KEY_ASSISTANT=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_GUARDRAIL=gpt-5.4-nano

# CORS: lista cerrada (sitio publico y webapp). Vacio = sin CORS (solo mismo origen).
CORS_ORIGINS=https://telintec.mx,https://telintec.com.mx,https://main.d2vgjmty2204yz.amplifyapp.com

# Topes del agente virtual de ventas (docs/agentes_openai.md del repo GUITelintec)
LIMIT_MESSAGES_PER_CONVERSATION=30
LIMIT_CONVERSATIONS_PER_IP_DAY=20
LIMIT_TOKENS_PER_DAY_SALES=3000000
LIMIT_OUTPUT_TOKENS=600

# Ventas: a donde manda el agente cuando no puede seguir y a quien llegan las solicitudes
SALES_WHATSAPP_URL=https://wa.me/message/TBYVN75NGL4JJ1
SALES_EMAILS=
